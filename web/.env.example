# Provisioned by the Vercel integrations
# Production default: neon. node-postgres is reserved for isolated PostgreSQL integration tests.
DATABASE_DRIVER=neon
DATABASE_URL=
DATABASE_URL_UNPOOLED=
# Restricted LOGIN roles provisioned after the Phase 1 role migration.
DATABASE_AUTHENTICATED_URL=
DATABASE_SYSTEM_URL=
DATABASE_PURGE_URL=
DATABASE_AUTH_URL=
# Maximum connections per cached runtime pool and credential URL (1-50).
DATABASE_POOL_MAX=10
DATABASE_AUTH_POOL_MAX=5
PRODUCTION_DATA_REGION=eu
YODEV_INTERNAL_AUTH_ORGANIZATION_ID=
BETTER_AUTH_SECRET=
BETTER_AUTH_GOOGLE_CLIENT_ID=
BETTER_AUTH_GOOGLE_CLIENT_SECRET=
BETTER_AUTH_EMAIL_PASSWORD_ENABLED=1
BETTER_AUTH_TRUSTED_ORIGINS=
BETTER_AUTH_ALLOWED_EMAILS=
AUTH_BOOTSTRAP_EMAIL=
AUTH_FROM_EMAIL=Ads by Yodev <ads@yodev.fr>
# One-time Clerk export only; remove these after auth:migrate-clerk succeeds.
CLERK_SECRET_KEY=
# Set only for the reviewed rollback window; release verification otherwise rejects Clerk variables.
LEGACY_AUTH_ROLLBACK_ENABLED=0
BETTER_AUTH_MIGRATION_APPLY=0
BETTER_AUTH_MIGRATION_CONFIRM_HOST=
BLOB_READ_WRITE_TOKEN=

# Ads by Yodev application secrets
APP_ENCRYPTION_KEY=
# Versioned envelope keys. Keep legacy APP_ENCRYPTION_KEY during dual-read rotation.
# Example: {"2026-08":"base64url-32-byte-key"}
APP_ENCRYPTION_KEYS=
APP_ENCRYPTION_CURRENT_KID=
OAUTH_STATE_KEY=
RATE_LIMIT_HASH_KEY=
OTP_HASH_KEY=
LEGAL_FINGERPRINT_KEY=
DELETION_TOMBSTONE_KEY=
GOOGLE_ADS_DEVELOPER_TOKEN=
GOOGLE_ADS_API_VERSION=v25
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
GOOGLE_OAUTH_REDIRECT_URI=https://ads.yodev.fr/api/google-ads/callback
NEXT_PUBLIC_APP_URL=https://ads.yodev.fr
CRON_SECRET=
RELEASE_VERIFICATION_TOKEN=
SENTRY_DSN=
NEXT_PUBLIC_SENTRY_DSN=
SENTRY_AUTH_TOKEN=
# Dedicated runtime token with event:read only; keep separate from the org:ci release token above.
SENTRY_EVENT_READ_AUTH_TOKEN=
SENTRY_ORG=
SENTRY_PROJECT=

# Optional commercial and notification services
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_SOLO=
STRIPE_PRICE_STUDIO=
STRIPE_PRICE_AGENCY=
STRIPE_PORTAL_CONFIGURATION_ID=
# YoDevMail is the only transactional-email transport used by YoDevAds.
NOTIFICATION_FROM_EMAIL=Ads by Yodev <ads@yodev.fr>
REPORT_FROM_EMAIL=Ads by Yodev <ads@yodev.fr>
TASK_FROM_EMAIL=Ads by Yodev <ads@yodev.fr>
LIFECYCLE_FROM_EMAIL=Ads by Yodev <ads@yodev.fr>
SUPPORT_EMAIL=
SUPPORT_FROM_EMAIL=Ads by Yodev <ads@yodev.fr>
OPERATIONS_ALERT_EMAIL=
YODEV_MAIL_API_URL=https://api.mail.yodev.fr
YODEV_MAIL_API_KEY=
YODEV_MAIL_WEBHOOK_SECRET=
YODEV_MAIL_RECIPIENT_HASH_SECRET=
SLACK_CLIENT_ID=
SLACK_CLIENT_SECRET=
MICROSOFT_CLIENT_ID=
MICROSOFT_CLIENT_SECRET=
MAINTENANCE_MODE=0
RELEASE_TARGET=staging

# Fail-closed product flags and emergency kill switches
GOOGLE_READS_ENABLED=0
GOOGLE_MUTATIONS_ENABLED=0
GOOGLE_MUTATION_STATUS_ENABLED=0
GOOGLE_MUTATION_BUDGET_ENABLED=0
GOOGLE_MUTATION_KEYWORDS_ENABLED=0
GOOGLE_MUTATION_ADS_ENABLED=0
GOOGLE_MUTATION_BATCH_ENABLED=0
STRIPE_CHECKOUT_ENABLED=0
PUBLIC_API_ENABLED=0
# Comma-separated workspace UUIDs allowed into the private API beta. Internal workspaces are allowed when the flag is on.
PRIVATE_API_WORKSPACE_IDS=
CUSTOM_DOMAINS_ENABLED=0
BLOB_UPLOADS_ENABLED=0
SLACK_CONNECTOR_ENABLED=0
TEAMS_CONNECTOR_ENABLED=0
PUBLIC_BETA_ENABLED=0
SCHEDULER_ENABLED=0
SCHEDULER_MAX_JOBS_PER_RUN=25
NOTIFICATIONS_ENABLED=0
FORCE_READ_ONLY=1

# Authenticated staging E2E. Store state files are short-lived CI secrets/artifacts,
# never committed. Set the gate to 1 for release-candidate verification.
PLAYWRIGHT_REQUIRE_AUTH_MATRIX=0
PLAYWRIGHT_OWNER_STORAGE_STATE=
PLAYWRIGHT_ADMIN_STORAGE_STATE=
PLAYWRIGHT_STRATEGIST_STORAGE_STATE=
PLAYWRIGHT_ANALYST_STORAGE_STATE=
PLAYWRIGHT_CLIENT_STORAGE_STATE=
# Existing export UUID owned by a separate fixture workspace; direct access must remain non-enumerating.
PLAYWRIGHT_FOREIGN_EXPORT_ID=

# Checkout remains blocked until one reviewed tax mode is selected.
# Allowed values: exempt_293b | stripe_tax
STRIPE_TAX_MODE=
# Required before stripe_tax can be enabled after legal/accounting validation.
STRIPE_TAX_CONFIGURATION_VALIDATED=0
LEGAL_DOCUMENTS_APPROVED=0
API_IP_HASH_KEY=
STRIPE_PROMOTION_CODES_ENABLED=0

# Agency custom domains (Vercel project-domain API)
VERCEL_API_TOKEN=
VERCEL_PROJECT_ID=
VERCEL_TEAM_ID=
